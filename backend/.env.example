PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/campusgigs
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
# Optional shared secret sent from the backend to the AI service.
AI_SERVICE_TOKEN=
# Set to true when running behind a trusted reverse proxy.
TRUST_PROXY=false
# error | warn | info | debug
LOG_LEVEL=debug
# Optional: local MongoDB used by backend tests. Never point this at production.
TEST_MONGO_URI=mongodb://127.0.0.1:27017
