PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/campusgigs
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
AI_SERVICE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
# Shared secret sent to the AI service. Required in production when
# AI_SERVICE_URL is set (and vice versa); the AI service must use the same value.
AI_SERVICE_TOKEN=
# Number of trusted reverse-proxy hops in front of the API (e.g. 1 for a
# single nginx/ALB). Leave false when the API is directly exposed.
TRUST_PROXY=false
# error | warn | info | debug
LOG_LEVEL=debug
# Optional: local MongoDB used by backend tests. Never point this at production.
TEST_MONGO_URI=mongodb://127.0.0.1:27017
