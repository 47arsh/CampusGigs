GEMINI_API_KEY=your_gemini_api_key_here
# development | production. In production the service refuses to start without
# AI_SERVICE_TOKEN so /chat cannot be called unauthenticated.
APP_ENV=development
# Shared secret. When set, /chat requires the X-Internal-Token header; the
# Express backend must send the same value.
AI_SERVICE_TOKEN=
# Optional model overrides. Use the same embedding model for ingestion and
# querying; changing it requires re-running rag/ingest.py.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-2-preview
# GEMINI_GENERATION_MODEL=gemini-3.6-flash
